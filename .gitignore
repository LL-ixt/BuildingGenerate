# ============================================================ Unity (project in /Unity)
# Cache / build output, regenerated by the Editor
Unity/[Ll]ibrary/
Unity/[Tt]emp/
Unity/[Oo]bj/
Unity/[Bb]uild/
Unity/[Bb]uilds/
Unity/[Ll]ogs/
Unity/[Uu]ser[Ss]ettings/
Unity/[Mm]emoryCaptures/
Unity/[Rr]ecordings/
Unity/.vs/
Unity/.vscode/
Unity/.idea/

# Generated by Unity for the IDE
Unity/*.csproj
Unity/*.unityproj
Unity/*.sln
Unity/*.slnx
Unity/*.suo
Unity/*.user
Unity/*.userprefs
Unity/*.pidb
Unity/*.booproj

# Screenshots taken through Unity MCP
Unity/Captures/
Unity/Captures.meta

# Crash dumps / profiler captures
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.app
*.pdb
*.mdb
*.opendb
*.VC.db
mono_crash.*

# Generated map data, rebuilt by CityPlacer / ChunkBuilder / MetroBuilder from the pipeline output.
# HLOD meshes (~250 MB) come from Hanoi > City > Build HLOD; metro mesh from MetroBuilder.RebuildBatch.
Unity/Assets/Hanoi/City/HLOD/
Unity/Assets/Hanoi/City/HLOD.meta
Unity/Assets/Hanoi/Metro/Generated/
Unity/Assets/Hanoi/Metro/Generated.meta
# Chunk scenes (~140 MB) can hold hand edits (locked buildings); uncomment only if you never edit by hand:
# Unity/Assets/Hanoi/City/Chunks/
# Unity/Assets/Hanoi/City/Chunks.meta

# ============================================================ Player builds, logs, benchmarks
Builds/
Unity_logs/

# ============================================================ Blender
# Auto backup written next to every saved .blend
*.blend1
*.blend2
*.blend@
# Rendered previews (~100 MB), rebuilt by the *_sheet.py / preview_modules.py scripts
Blender/previews/

# ============================================================ Python
__pycache__/
*.py[cod]
.venv/
venv/

# ============================================================ Downloaded archives / derived data
# Raw CC0 texture zips (the extracted maps are what the scripts read)
Textures/src/**/*.zip
# Pipeline scratch output and backups (the .geojson / city.json files stay)
Map/out/*.png
Map/out/city_before_*.json
Map/out/*_shot.json

# ============================================================ OS / editors / tools
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.vs/
.idea/
.vscode/
*.log

# Claude Code local settings (the shared .mcp.json is kept)
.claude/settings.local.json
