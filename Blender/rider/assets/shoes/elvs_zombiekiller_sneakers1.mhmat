# Material definition for elvs_zombiekiller_sneakers1

name elvs_zombiekiller_sneakers1
description Elvs_zombiekiller_sneakers1 material
ambientColor 1.0 1.0 1.0
diffuseColor 0.5 0.5 0.5
specularColor 0.5 0.5 0.5
shininess 0.5
emissiveColor 0.0 0.0 0.0
opacity 1.0
translucency 0.0

shadeless False
wireframe False
transparent True
alphaToCoverage True
backfaceCull False
depthless False

castShadows True

receiveShadows True

diffuseTexture sneakerstexture1.png
normalmapTexture normals.png
normalmapIntensity 1.5

shader shaders/glsl/litsphere

shaderParam litsphereTexture litspheres/lit_leather.png
