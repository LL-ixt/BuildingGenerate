  <tag k="alt_name" v="Nhân Mục"/>
  <tag k="description" v="Vùng Nhân Mục xưa có tên nôm là Kẻ Mọc. Theo Quốc sử tạp lục thì hồi thế kỷ X, các làng Mọc đều có rừng, vậy mới có tên là Kẻ Mọc, tên chữ là Mộc Cự, sau đổi là Nhân Mục."/>
