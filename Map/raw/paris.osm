 <node id="11183774359" visible="true" version="1" changeset="141120985" timestamp="2023-09-11T15:55:11Z" user="Yod4z" uid="318821" lat="48.8606970" lon="2.3582787">
  <tag k="artist_name" v="Jean-Baptiste II Lemoine"/>
  <tag k="artwork_type" v="relief"/>
  <tag k="description" v="L'interprétation de ces deux allégories, qui ne trouvent pas de correspondances exactes dans l'ouvrage de Ripa, est la plus problématique. On a pu y voir l'opposition entre la Fable, dont le masque vient d'être retiré par un génie et la Vérité."/>
  <tag k="indoor" v="yes"/>
  <tag k="level" v="0"/>
  <tag k="name" v="La Fable et la Vérité"/>
  <tag k="support" v="wall_mounted"/>
  <tag k="tourism" v="artwork"/>
 </node>
 <node id="11183774360" visible="true" version="1" changeset="141120985" timestamp="2023-09-11T15:55:11Z" user="Yod4z" uid="318821" lat="48.8607497" lon="2.3581778">
  <tag k="artist_name" v="Jean-Baptiste II Lemoine"/>
  <tag k="artwork_type" v="relief"/>
  <tag k="description" v="L'Épopée et la Tragédie empruntent quelques-uns des attributs des muses Calliope et Melpomène. L'Épopée, devant la proue d'un navire, porte sur les genoux un rouleau où elle inscrit le premier vers de l'Enéide &quot;Arma virumque ano...&quot;."/>
  <tag k="indoor" v="yes"/>
  <tag k="level" v="0"/>
  <tag k="name" v="L'Épopée et la Tragédie"/>
  <tag k="support" v="wall_mounted"/>
  <tag k="tourism" v="artwork"/>
 </node>
 <node id="11183774361" visible="true" version="1" changeset="141120985" timestamp="2023-09-11T15:55:11Z" user="Yod4z" uid="318821" lat="48.8607154" lon="2.3581767">
  <tag k="artist_name" v="Jean-Baptiste II Lemoine"/>
  <tag k="artwork_type" v="relief"/>
  <tag k="description" v="L'Astronomie est une femme ailée qui, de son compas, prend les mesures d'un globe céleste. Elle a les yeux tournés vers le ciel, objet de son étude, et est accompagnée d'un aigle, roi des oiseaux."/>
  <tag k="indoor" v="yes"/>
  <tag k="level" v="0"/>
  <tag k="name" v="L'Astronomie"/>
  <tag k="support" v="wall_mounted"/>
  <tag k="tourism" v="artwork"/>
 </node>
 <node id="11183774362" visible="true" version="3" changeset="147749503" timestamp="2024-02-21T21:05:22Z" user="Yaaaaaaaa" uid="14093483" lat="48.8606931" lon="2.3582131">
  <tag k="artist_name" v="Jean-Baptiste II Lemoine"/>
  <tag k="artwork_type" v="relief"/>
  <tag k="description" v="Acompagnée d'enfants arpenteurs à qui elle indique les mesures à prendre, la Géométrie porte à la main une équerre et une boussole. A ces pieds, le livre des Eléments d'Euclide et la figure du théorème de Pythagore."/>
  <tag k="indoor" v="yes"/>
  <tag k="level" v="0"/>
  <tag k="name" v="La géométrie"/>
  <tag k="support" v="wall_mounted"/>
  <tag k="tourism" v="artwork"/>
 </node>
