  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="Maison de la famille Cœur sise rue de lHomme armé. Appartenait au XVIIe siècle à la petite fille de Jacques Cœur, Marie femme d'Eustache Luillier, prévôt des marchands"/>
  <tag k="memorial" v="plaque"/>
  <tag k="openplaques:id" v="11382"/>
  <tag k="panoramax" v="78ddf8fd-365f-4bb6-9eb5-46598d4aecae"/>
